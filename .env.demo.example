# Copy this file to .env.demo and fill only the copied file.
# Do not commit real account IDs, tokens, passwords, or API keys.

SMC_TA_MODE=demo
SMC_TA_BROKER=oanda
SMC_TA_SYMBOLS=EURUSD
SMC_TA_TIMEFRAMES=M15
SMC_TA_ACCOUNT_CURRENCY=USD
SMC_TA_MAX_TRADE_RISK_PERCENT=1.0

# OANDA practice account credentials.
# Use practice credentials first. Keep SMC_TA_OANDA_PRACTICE=true for demo.
SMC_TA_OANDA_ACCOUNT_ID=replace_with_oanda_practice_account_id
SMC_TA_OANDA_TOKEN=replace_with_oanda_practice_token
SMC_TA_OANDA_PRACTICE=true
SMC_TA_OANDA_MAX_SPREAD_PIPS=2
SMC_TA_OANDA_MAX_PRICE_AGE_SECONDS=15

# Required before repeated bot loops.
SMC_TA_JOURNAL_PATH=state/trades.sqlite
SMC_TA_LIFECYCLE_DB_PATH=state/trade_lifecycle.sqlite

# Optional real alert channels. Configure at least one before repeated
# demo/live-style loops, then run examples/validate_alert_channels.py.
# SMC_TA_TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
# SMC_TA_TELEGRAM_CHAT_ID=replace_with_telegram_chat_id
# SMC_TA_DISCORD_WEBHOOK_URL=replace_with_discord_webhook_url
# SMC_TA_SMTP_HOST=replace_with_smtp_host
# SMC_TA_SMTP_PORT=587
# SMC_TA_SMTP_USERNAME=replace_with_smtp_username
# SMC_TA_SMTP_PASSWORD=replace_with_smtp_password
# SMC_TA_EMAIL_FROM=replace_with_sender_email
# SMC_TA_EMAIL_TO=replace_with_operator_email
# SMC_TA_SMTP_USE_TLS=true

# Keep false until a real economic calendar provider is configured.
SMC_TA_REQUIRE_NEWS_FILTER=false
